<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- AR SceneView: View hiển thị Camera AR và Bộ dựng hình 3D (Google Filament) chiếm toàn màn hình -->
    <io.github.sceneview.ar.ARSceneView
        android:id="@+id/sceneView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 1. GIAO DIỆN PHỤ TRỢ (OVERLAY HUD): CARD TRẠNG THÁI HƯỚNG DẪN BÁN TRONG SUỐT Ở TRÊN MÀN HÌNH -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardInstruction"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="48dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#B30F172A"
        app:strokeColor="#33FFFFFF"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/fabReset">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">

            <ProgressBar
                android:id="@+id/loadingIndicator"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:indeterminate="true"
                android:indeterminateTint="@android:color/white"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/tvInstruction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/status_scan_plane"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- NÚT TRÒN FLOATINGACTIONBUTTON NHỎ GÓC TRÊN BÊN PHẢI ĐỂ RESET SCENE -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabReset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        app:fabCustomSize="48dp"
        app:elevation="4dp"
        app:backgroundTint="#CC1E293B"
        app:tint="@android:color/white"
        app:srcCompat="@android:drawable/ic_menu_rotate"
        app:maxImageSize="22dp"
        app:borderWidth="1dp"
        app:borderColor="#33FFFFFF"
        android:contentDescription="@string/content_desc_reset"
        app:layout_constraintTop_toTopOf="@id/cardInstruction"
        app:layout_constraintBottom_toBottomOf="@id/cardInstruction"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- DANH SÁCH CHỌN MÔ HÌNH 3D (RECYCLERVIEW) CUỘN NGANG ĐẶT NỔI Ở ĐÁY MÀN HÌNH -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvModelPicker"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="28dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_model_selector" />

</androidx.constraintlayout.widget.ConstraintLayout>
