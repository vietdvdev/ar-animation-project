<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- LỚP 1: TẦNG NỀN (BACKGROUND) - CAMERAX PREVIEW HIỂN THỊ KHUNG HÌNH THỜI GIAN THỰC -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- LỚP 2: TẦNG MÔ HÌNH (OVERLAY) - 3D SCENEVIEW TRONG SUỐT ĐÈ LÊN TRÊN CAMERA -->
    <io.github.sceneview.SceneView
        android:id="@+id/sceneView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- LỚP 3: TẦNG GIAO DIỆN (UI CONTROLS) - NẰM TRÊN CÙNG -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- CARD TRẠNG THÁI HƯỚNG DẪN BÁN TRONG SUỐT Ở TRÊN MÀN HÌNH -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardInstruction"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="48dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#B30F172A"
            app:strokeColor="#33FFFFFF"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/fabSwitchCamera">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp">

                <ProgressBar
                    android:id="@+id/loadingIndicator"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@android:color/white"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:id="@+id/tvInstruction"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="2"
                    android:ellipsize="end"
                    tools:text="Đang tải mô hình..." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- NÚT ĐỔI CAMERA TRƯỚC / SAU (SWITCH CAMERA) Ở GÓC TRÊN BÊN PHẢI -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabSwitchCamera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            app:fabCustomSize="48dp"
            app:elevation="4dp"
            app:backgroundTint="#CC1E293B"
            app:tint="@android:color/white"
            app:srcCompat="@android:drawable/ic_popup_sync"
            app:maxImageSize="22dp"
            app:borderWidth="1dp"
            android:contentDescription="@string/content_desc_switch_camera"
            app:layout_constraintTop_toTopOf="@id/cardInstruction"
            app:layout_constraintBottom_toBottomOf="@id/cardInstruction"
            app:layout_constraintEnd_toStartOf="@id/fabReset" />

        <!-- NÚT RESET VỊ TRÍ CON VẬT VỀ TÂM MÀN HÌNH -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabReset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            app:fabCustomSize="48dp"
            app:elevation="4dp"
            app:backgroundTint="#CC1E293B"
            app:tint="@android:color/white"
            app:srcCompat="@android:drawable/ic_menu_rotate"
            app:maxImageSize="22dp"
            app:borderWidth="1dp"
            android:contentDescription="@string/content_desc_reset"
            app:layout_constraintTop_toTopOf="@id/cardInstruction"
            app:layout_constraintBottom_toBottomOf="@id/cardInstruction"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- NHÃN ĐẾM THỜI LƯỢNG QUAY VIDEO (RECORD TIMER HUD) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRecordTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#CCEF4444"
            app:strokeColor="#FFFFFF"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/cardInstruction"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp">

                <View
                    android:id="@+id/viewBlinkDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@android:color/white"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvRecordTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-black"
                    android:text="00:00" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- NÚT QUAY PHIM NỔI (RECORD BUTTON) HÌNH TRÒN LỚN NẰM PHÍA TRÊN THANH CHỌN CON VẬT -->
        <View
            android:id="@+id/btnRecord"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_record_idle"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/content_desc_record"
            app:layout_constraintBottom_toTopOf="@id/rvModelPicker"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- THANH TRƯỢT NGANG CHỌN 6 CON VẬT (RECYCLERVIEW) SÁT MÉP ĐÁY MÀN HÌNH -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvModelPicker"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="28dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:listitem="@layout/item_model_selector" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
